#!/bin/bash
# =============================================================================
# run_onchange_07-looking-glass.sh.tmpl
# Run by chezmoi whenever this file changes. It is run_onchange_, not run_once_,
# because the script has a teardown branch: run_once keys its state on every
# content hash it has ever seen, so a second disable after a re-enable would
# silently do nothing. run_onchange compares with the last run instead.
# Looking Glass — IVSHMEM shared memory (client config lives in
# dot_config/looking-glass/client.ini)
#
# OPTIONAL — configured only while the "looking_glass" component is enabled;
# disabling it removes the config (component-guard + looking-glass-teardown).
#
# The etc-hash below covers the system files this script installs, so chezmoi
# re-runs it when one of them changes.
# etc-hash: {{ include "etc/tmpfiles.d/looking-glass.conf" | sha256sum | trunc 8 }}
# =============================================================================
set -e

# Logging helpers: lib/logging.sh ships in the chezmoi source dir and is always
# present when run_once scripts run under chezmoi, so no fallback is needed.
source "${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}/lib/logging.sh"

{{ template "component-guard" (dict "name" "looking_glass" "data" . "teardown" "looking-glass-teardown") }}

SCRIPT_DIR="${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}"
source "$SCRIPT_DIR/lib/system.sh"

log_info "Configuring Looking Glass..."

# ---------------------------------------------------------------------------
# Shared memory (IVSHMEM) — versioned under etc/
# ---------------------------------------------------------------------------
# The tmpfiles file is static (root:kvm 0660): access goes through the kvm
# group, which run_once_06-libvirt-setup.sh adds the user to.
if install_system_file etc/tmpfiles.d/looking-glass.conf; then
  sudo systemd-tmpfiles --create /etc/tmpfiles.d/looking-glass.conf
fi

log_pass "Looking Glass shared memory configured."
log_detail "Client config: ~/.config/looking-glass/client.ini (shmFile=/dev/shm/looking-glass)"
log_detail "Install the Looking Glass host (looking-glass-host) inside the Windows VM."

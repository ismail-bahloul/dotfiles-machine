# looking-glass-teardown — undo the configuration installed by
# run_onchange_07-looking-glass.sh.tmpl when the "looking_glass" component is
# disabled. Called from component-guard; see that template for the contract.
#
# What it does NOT do: uninstall the `looking-glass` package, touch VFIO, or
# remove the user from the kvm group. Those belong to the package and to the
# `virtualization` component, and this repo never uninstalls anything.

if [ -f /etc/tmpfiles.d/looking-glass.conf ]; then
  sudo rm -f /etc/tmpfiles.d/looking-glass.conf
  log_detail "removed /etc/tmpfiles.d/looking-glass.conf"
fi
sudo rm -f /dev/shm/looking-glass

log_pass "Looking Glass configuration removed (package left installed)."
